{
  "invoiceTemplate": "<div class=\"invoice-card\"><div class=\"invoice-inner-content\"><div class=\"invoice-title\">Billing Invoice</div><div class=\"header-section\"><div class=\"company-details\"><h2 id=\"inv-centre-name\">--</h2><p id=\"inv-centre-type\">--</p><p id=\"inv-branch-name\">--</p><p id=\"inv-branch-addr\">--</p><p id=\"inv-branch-phone\">--</p></div><div class=\"logo-container\"><img src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgEslg168FuctZ1yyQPpziK4Mi0c5RbIBoIxDN8Se_FmRTq-odznxbGRCnTByZWXMgCDgGZ1rjrPVvnP7TAR_6m8DPvkndeMG2nco6LAO49kSyJwPSChEWyvJuHSBPgl97Hc6NQYY6CMbQGcyLOOrCrqstA3hdoZ3VYyu7KCyfPzPZO9Z4fS441SXbSn-to/s1600/IMG-20260526-WA0002.jpg\" alt=\"Logo\" class=\"logo-style\" crossorigin=\"anonymous\"></div><div class=\"invoice-meta\"><p><strong>Invoice #<span id=\"inv-pid\"></span></strong></p><p><strong>Issue Date:</strong> <span id=\"inv-date\"></span></p></div></div><div class=\"dashed-line\"></div><div class=\"billing-info\"><div><strong>Name:</strong> <span id=\"inv-name\"></span><br><strong>Address:</strong> <span id=\"inv-addr\"></span></div><div><strong>Age:</strong> <span id=\"inv-age\"></span><br><strong>Phone:</strong> <span id=\"inv-phone\"></span></div><div><strong>Gender:</strong> <span id=\"inv-gender\"></span></div></div><table class=\"invoice-table\"><thead><tr><th width=\"5%\">#</th><th width=\"37%\">Bill Item</th><th width=\"13%\">Type</th><th width=\"7%\">Qty</th><th width=\"12%\">Rate</th><th width=\"12%\">Disc</th><th width=\"14%\">Amount</th></tr></thead><tbody id=\"inv-items\"></tbody></table><div style=\"font-size:8.5px;margin-bottom:20px;white-space:nowrap\"><strong>Total Payable In Word:</strong> <span id=\"inv-words\"></span><img src=\"data:,\" style=\"display:none\" onerror=\"(function(){function n2w(num){if(num===0)return 'Zero';var ones=['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];var tens=['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];function two(x){if(x<20)return ones[x];return tens[Math.floor(x/10)]+(x%10?' '+ones[x%10]:'');}function three(x){if(x>=100)return ones[Math.floor(x/100)]+' Hundred'+(x%100?' '+two(x%100):'');return two(x);}var s='';var crore=Math.floor(num/10000000);num%=10000000;var lakh=Math.floor(num/100000);num%=100000;var thousand=Math.floor(num/1000);num%=1000;var rest=num;if(crore)s+=three(crore)+' Crore ';if(lakh)s+=three(lakh)+' Lakh ';if(thousand)s+=three(thousand)+' Thousand ';if(rest)s+=three(rest)+' ';return s.trim();}function upd(){var tb=document.getElementById('inv-items');if(!tb)return;var rows=tb.querySelectorAll('tr');var amt=null;rows.forEach(function(r){var tds=r.querySelectorAll('td');if(tds.length&&/Payable Amount/i.test(tds[0].textContent)){amt=tds[tds.length-1].textContent;}});if(amt==null)return;var num=parseInt(amt.replace(/[^0-9]/g,''),10);if(isNaN(num))return;var w=document.getElementById('inv-words');if(w)w.textContent=n2w(num)+' Taka Only';}var tb=document.getElementById('inv-items');if(tb){var mo=new MutationObserver(upd);mo.observe(tb,{childList:true,subtree:true,characterData:true});upd();}})()\"></div><div style=\"font-size:8px;text-align:center;line-height:1.3\"><p>*Terms and Conditions Applied. Thank you for trusting us.</p></div></div></div>"
