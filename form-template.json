{
  "formTemplate": "<div class=card-form><div class=top-bar-form></div><div class=header-form><h1>🌿 Appointment</h1><p>নিচের তথ্যগুলো পূরণ করুন</div><div class=body-form><div class=full-form><div class=name-label-row><label>Patient Name</label><div class=category-checks><label><input onchange=\"onTypeChange(this,'Home')\" id=typeHome type=checkbox>Home</label><label><input onchange=\"onTypeChange(this,'Center')\" checked id=typeCenter type=checkbox>Center</label></div><div class=category-checks><label><input onchange=\"onCatChange(this,'Ruqyah')\" checked id=catRuqyah type=checkbox>Ruqyah</label><label><input onchange=\"onCatChange(this,'Hijama')\" id=catHijama type=checkbox>Hijamah</label></div></div><input oninput='this.value=this.value.replace(/[0-9]/g,\"\")' placeholder=\"Enter full name\" id=pName></div><div class=row-form><div><label>Phone No. (WA)</label><input placeholder=\"Enter phone number\" id=phone oninput=window.handlePhoneInput(this) type=tel></div><div><label>Gender</label><div class=dd><button onclick='toggleMenu(\"gMenu\")' class=dd-btn id=gBtn type=button><span id=gVal>Select</span><span>▾</span></button><div class=dd-menu id=gMenu><span onclick='pickGender(\"Male\")'>Male</span><span onclick='pickGender(\"Female\")'>Female</span><span onclick='pickGender(\"Other\")'>Other</span></div></div></div></div><div class=row-form><div><label>Address</label><div class=dd><div class=\"dd-btn time-btn\" id=addrBtn><input type=text id=addrVal placeholder=\"Select or Type Address\" autocomplete=off onfocus='toggleMenu(\"addrMenu\")' oninput='onAddrTyped(this)'><span class=dd-arrow onclick='toggleMenu(\"addrMenu\")'>▾</span></div><div class=dd-menu id=addrMenu></div></div></div><div class=row-form><div><label>Age</label><input oninput='this.value=this.value.replace(/[^0-9]/g,\"\"),this.value>120&&(this.value=120)' id=ageInput inputmode=numeric placeholder=Years></div><div><label>Patient Type</label><div class=dd><button onclick='toggleMenu(\"ptypeMenu\")' class=\"dd-btn selected\" id=ptypeBtn type=button><span id=ptypeVal>New</span><span>▾</span></button><div class=dd-menu id=ptypeMenu><span onclick='pickPatientType(\"New\")'>New</span><span onclick='pickPatientType(\"Old\")'>Old</span></div></div></div></div></div><div class=row-form><div><label>Schedule Time</label><div class=dd><div class=\"dd-btn time-btn\" id=timeBtn><input type=text id=timeVal placeholder=\"Select or Type Time\" autocomplete=off onfocus='toggleMenu(\"timeMenu\")' oninput='onTimeTyped(this)'><span class=dd-arrow onclick='toggleMenu(\"timeMenu\")'>▾</span></div><div class=dd-menu id=timeMenu></div></div></div><div><label>Schedule Date</label><div onclick=\"this.querySelector('input').showPicker()\" class=date-wrapper><input id=dateInput onchange=updateDateFormat(this) required type=date><div class=date-display id=dateLabel>Select Date</div></div></div></div><div class=footer-form><button class=btn-submit onclick=generateSlip() type=button>Submit</button><button class=btn-clear onclick=clearForm() type=button>Clear form</button></div></div></div><div id=slipTemplate></div>"
}
